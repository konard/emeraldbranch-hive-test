---
import type { ClientFacts, DesignDirection, ResolvedSection } from "../../lib/site-builder";

interface Props {
  section: ResolvedSection;
  client: ClientFacts;
  design: DesignDirection;
}

const { section, client } = Astro.props;
const integration = section.integration ?? {};
---

<section
  id={section.id}
  class="section section--lead"
  data-section-type={section.type}
  data-section-variant={section.variant}
  data-chatbot-intent={integration.chatbotIntent}
  data-crm-route={integration.crmRoute}
  data-n8n-webhook={integration.n8nWebhook}
>
  <div class="section__inner lead-layout">
    <div class="lead-copy">
      <p class="eyebrow">{client.phone}</p>
      <h2>{section.headline}</h2>
      {section.body && <p>{section.body}</p>}
      <a class="text-link" href={`mailto:${client.email}`}>{client.email}</a>
    </div>
    <form class="lead-form" action={integration.formAction ?? "#"} method="post">
      <input type="hidden" name="crm_route" value={integration.crmRoute} />
      <input type="hidden" name="chatbot_intent" value={integration.chatbotIntent} />
      <label>
        <span>Name</span>
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        <span>Vehicle</span>
        <input name="vehicle" autocomplete="off" required />
      </label>
      <label>
        <span>Goal</span>
        <textarea name="goal" rows="4" required></textarea>
      </label>
      <div class="lead-form__actions">
        <button class="button button--primary" type="submit">Send request</button>
        {
          integration.bookingUrl && (
            <a class="button button--secondary" href={integration.bookingUrl}>
              Book time
            </a>
          )
        }
      </div>
    </form>
  </div>
</section>
