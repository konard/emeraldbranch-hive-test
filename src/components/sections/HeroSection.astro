---
import type { ClientFacts, DesignDirection, ResolvedSection } from "../../lib/site-builder";
import CtaLinks from "../CtaLinks.astro";
import MediaAsset from "../MediaAsset.astro";

interface Props {
  section: ResolvedSection;
  client: ClientFacts;
  design: DesignDirection;
}

const { section, client } = Astro.props;
const backgroundMedia =
  section.media.find((media) => media.placement === "background") ??
  section.media[0];
---

<section
  id={section.id}
  class="section section--hero"
  data-section-type={section.type}
  data-section-variant={section.variant}
>
  {
    backgroundMedia && (
      <div class="hero__media">
        <MediaAsset media={backgroundMedia} loading="eager" background />
      </div>
    )
  }
  <div class={`media-overlay media-overlay--${backgroundMedia?.overlay ?? "none"}`}></div>
  <div class="hero__content">
    <p class="eyebrow">{client.category} in {client.location}</p>
    <h1>{section.headline}</h1>
    {section.body && <p class="lede">{section.body}</p>}
    <CtaLinks ctas={section.ctas} align="center" />
  </div>
</section>
